{
  "name": "@moyodb/sdk",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:wasm": "npm run build:wasm:release",
    "build:wasm:release": "wasm-pack build ../../crates/engine --release --target web --out-dir ../../packages/sdk/public/engine --out-name moyodb_engine",
    "build:wasm:dev": "wasm-pack build ../../crates/engine --dev --target web --out-dir ../../packages/sdk/public/engine --out-name moyodb_engine",
    "build": "npm run build:wasm:release && vite build && npm run build:node && npm run build:types && npm run prepare:dist",
    "dev": "npm run build:wasm:release && vite --host 127.0.0.1 --port 4173",
    "dev:test": "npm run build:wasm:release && vite --host 127.0.0.1 --port 4173",
    "test:minimum-work": "node scripts/test-minimum-work.mjs && node scripts/test-read-work.mjs && node scripts/test-transport-work.mjs && node scripts/test-startup-work.mjs && node scripts/test-sdk-lifecycle.mjs && node scripts/test-codec-index-work.mjs && node scripts/test-worker-portability.mjs && node scripts/test-record-work.mjs && node --test --test-isolation=none tests/sql-parser.test.mjs",
    "bench:minimum-work": "node scripts/bench-minimum-work.mjs",
    "test:e2e": "npm run test:minimum-work && npm run build && npm run test:node && playwright test",
    "build:types": "tsc -p tsconfig.build.json",
    "bench:browser": "node scripts/run-playwright-env.mjs bench:browser",
    "bench:indexeddb": "node scripts/run-playwright-env.mjs bench:indexeddb",
    "bench:opfs": "node scripts/run-playwright-env.mjs bench:opfs",
    "bench:report": "node bench/generate-report.mjs",
    "test:soak": "node scripts/run-playwright-env.mjs test:soak",
    "test:browser:soak": "npm run test:soak",
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "build:node": "vite build --config vite.node.config.ts",
    "test:node": "node --test --test-isolation=none scripts/test-node-storage.mjs && node scripts/test-node-runtime.mjs && node scripts/test-sql-executor.mjs && node scripts/test-package-types.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0"
  },
  "description": "Rust/WASM transactional database SDK for browsers and Node.js with typed records and SQL.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Eluvane <keiko1337@proton.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/eluvane/MoyoDB.git"
  },
  "keywords": [
    "moyodb",
    "rust",
    "wasm",
    "webassembly",
    "database",
    "storage-engine",
    "browser",
    "opfs",
    "local-first",
    "key-value",
    "typescript",
    "transactions",
    "wal",
    "web-worker"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/moyodb-sdk.js"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/eluvane/MoyoDB#readme",
  "bugs": {
    "url": "https://github.com/eluvane/MoyoDB/issues"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=10.0.0"
  }
}
